<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ için kendi test bildirimimizi gösterebilmek -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Veli–çocuk bağlantısı ve uyarı gönderimi için -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ekran (OCR) ve ses analizi: kullanıcı onaylı MediaProjection + ön plan servisi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DijitalKalkan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DijitalKalkan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bildirim dinleyici servisi: yalnızca sistem bağlanabilir -->
        <service
            android:name=".monitoring.notification.MessageNotificationListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Ekran ve ses analizi (görünür bildirimle çalışır) -->
        <service
            android:name=".monitoring.screen.ScreenAudioMonitorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Firebase: veliye uyarı, çocuğa veli kelime listesi -->
        <service
            android:name=".notifications.DkMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
